root ::= object

object ::=
  "{" ws (
    "\"canonical_name\"" ws ":" ws string ","
    ws "\"confidence\"" ws ":" ws number
  ) "}" ws

string ::=
  "\"" (
    [^"\\\x7F\x00-\x1F] |
    "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
  )* "\"" ws

number ::= [0-9]+ ("." [0-9]+)? ws

ws ::= | " " | "\n" [ \t]{0,20}
