root ::= object

object ::=
  "{" (
    "\"a\"" ":" span ","
    "\"d\"" ":" span ","
    "\"t\"" ":" timenull ","
    "\"y\"" ":" txntype ","
    "\"r\"" ":" direction ","
    "\"m\"" ":" strnull ","
    "\"f\"" ":" strnull ","
    "\"v\"" ":" strnull
  ) "}"

span ::= "\"" spanchar{1,48} "\""

spanchar ::=
  [^"\\\x7F\x00-\x1F] |
  "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})

timenull ::= "null" | span

txntype ::=
  ("\"upi\"" | "\"imps\"" | "\"neft\"" | "\"rtgs\"" | "\"atm\"" |
   "\"card\"" | "\"salary\"" | "\"other\"")

direction ::= "\"debit\"" | "\"credit\""

strnull ::= "null" | string

string ::=
  "\"" (
    [^"\\\x7F\x00-\x1F] |
    "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
  )* "\""
