root ::= object
object ::= "{" ws pair (ws "," ws pair)* ws "}"
pair ::= string ws ":" ws value
string ::= "\"" char* "\""
char ::= [^"\\] | "\\" ["\\/bfnrt]
value ::= number | direction | txn_type | bool | iso_date | null | string
number ::= [0-9]+
direction ::= "\"debit\"" | "\"credit\""
txn_type ::= "\"upi\"" | "\"imps\"" | "\"neft\"" | "\"rtgs\"" | "\"atm\"" | "\"card\"" | "\"salary\"" | "\"other\""
bool ::= "true" | "false"
null ::= "null"
iso_date ::= "\"" date "T" time "Z\""
date ::= [0-9][0-9][0-9][0-9] "-" [0-9][0-9] "-" [0-9][0-9]
time ::= [0-9][0-9] ":" [0-9][0-9] ":" [0-9][0-9]
ws ::= [ \t\n\r]*
